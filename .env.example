APP_NAME="Laravel PHPUnit Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Default: SQLite, file database/database.sqlite sudah disediakan.
DB_CONNECTION=sqlite
# DB_DATABASE dibiarkan kosong agar memakai database_path('database.sqlite').

# Pilihan untuk MySQL (hapus komentar baris berikut dan ganti DB_CONNECTION):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_phpunit_lab
# DB_USERNAME=root
# DB_PASSWORD=
